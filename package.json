{
  "name": "mapnolia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:frontend": "bun --hot src/index.ts",
    "dev:backend": "cd server && go run .",
    "dev:relay": "nak serve",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "build:backend": "cd server && go build -o ../bin/mapnolia-server .",
    "build:all": "bun run build && bun run build:backend"
  },
  "dependencies": {
    "@nostr-dev-kit/ndk": "^3.0.0",
    "@nostr-dev-kit/react": "^1.3.13",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "pmtiles": "^4.4.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/bun": "^1.3.9",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  }
}
